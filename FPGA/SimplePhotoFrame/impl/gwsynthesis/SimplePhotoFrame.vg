  clk27m,
  lcd_ck,
  lcd_hs,
  lcd_vs,
  lcd_de,
  lcd_r,
  lcd_g,
  lcd_b,
  lcd_bl,
  led,
  fpga_spi_cs_n,
  fpga_spi_sck,
  fpga_spi_mosi,
  fpga_spi_miso,
  fpga_spi_intr,
  i2s_bclk,
  i2s_dout,
  i2s_en,
  i2s_lrck,
  ws2812,
  button,
  O_sdram_clk,
  O_sdram_cke,
  O_sdram_cs_n,
  O_sdram_ras_n,
  O_sdram_cas_n,

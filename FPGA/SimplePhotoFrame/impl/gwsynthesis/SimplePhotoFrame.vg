module cache_line (
  ram_instance_27,
  ram_instance_26,
  clk108m,
  ff_line0_wdata,
  ff_line_address,
  n9_6,
  w_line0_rdata
)
;
input ram_instance_27;
input ram_instance_26;
input clk108m;
input [17:0] ff_line0_wdata;
input [11:0] ff_line_address;
output n9_6;
output [17:0] w_line0_rdata;
wire [31:4] DO;
wire [31:4] DO_0;
wire [31:4] DO_1;
wire [31:4] DO_2;
wire [31:2] DO_3;
wire VCC;
wire GND;
  SDPB ram_instance_ram_instance_0_0_s (
    .DO({DO[31:4],w_line0_rdata[3:0]}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,ff_line0_wdata[3:0]}),
    .BLKSELA({GND,GND,GND}),
    .BLKSELB({GND,GND,GND}),
    .ADA({ff_line_address[11:0],GND,GND}),
    .ADB({ff_line_address[11:0],GND,GND}),
    .CLKA(n9_6),
    .CLKB(n9_6),
    .CEA(ram_instance_27),
    .CEB(ram_instance_26),
    .OCE(GND),
    .RESETA(GND),
    .RESETB(GND) 
);
defparam ram_instance_ram_instance_0_0_s.BIT_WIDTH_0=4;
defparam ram_instance_ram_instance_0_0_s.BIT_WIDTH_1=4;
defparam ram_instance_ram_instance_0_0_s.READ_MODE=1'b0;
defparam ram_instance_ram_instance_0_0_s.RESET_MODE="SYNC";
defparam ram_instance_ram_instance_0_0_s.BLK_SEL_0=3'b000;
defparam ram_instance_ram_instance_0_0_s.BLK_SEL_1=3'b000;
  SDPB ram_instance_ram_instance_0_1_s (
    .DO({DO_0[31:4],w_line0_rdata[7:4]}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,ff_line0_wdata[7:4]}),
    .BLKSELA({GND,GND,GND}),
    .BLKSELB({GND,GND,GND}),

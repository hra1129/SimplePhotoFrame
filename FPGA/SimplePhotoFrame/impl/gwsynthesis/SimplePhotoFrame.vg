defparam ff_ram_ff_ram_0_0_s.RESET_MODE="SYNC";
defparam ff_ram_ff_ram_0_0_s.WRITE_MODE=2'b10;
  SP ff_ram_ff_ram_0_1_s (
    .DO({DO_0[31:16],w_sram0_dout[31:16]}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,fifo_wdata[31:16]}),
    .BLKSEL({GND,GND,GND}),
    .AD({w_sram0_addr[9:0],GND,GND,VCC,VCC}),
    .WRE(w_sram0_we),
    .CLK(sysclk),
    .CE(VCC),
    .OCE(GND),
    .RESET(GND) 
);
defparam ff_ram_ff_ram_0_1_s.BIT_WIDTH=16;

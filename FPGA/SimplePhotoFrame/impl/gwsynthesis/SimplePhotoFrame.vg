module display_single_port_ram (
  w_sram0_we,
  sysclk,
  fifo_wdata,
  w_sram0_addr,
  w_sram0_dout
)
;
input w_sram0_we;
input sysclk;
input [31:0] fifo_wdata;
input [9:0] w_sram0_addr;
output [31:0] w_sram0_dout;
wire [31:16] DO;
wire [31:16] DO_0;
wire VCC;
wire GND;
  SP ff_ram_ff_ram_0_0_s (
    .DO({DO[31:16],w_sram0_dout[15:0]}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,fifo_wdata[15:0]}),
    .BLKSEL({GND,GND,GND}),
    .AD({w_sram0_addr[9:0],GND,GND,VCC,VCC}),
    .WRE(w_sram0_we),
    .CLK(sysclk),
    .CE(VCC),
    .OCE(GND),
    .RESET(GND) 
);
